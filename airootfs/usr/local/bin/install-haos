#!/usr/bin/env bash

# A menu driven shell script, hacked together from internet samples and other shit.
# In a previous life, this was the console menu for the Home Assistant TrueNAS Core
# Community Plugin. Now it's reborn to install Home Assistant OS in a VM on TrueNAS

# ==============================================================================
# - SCRIPT METADATA & VERSION CONTROL
# ==============================================================================
# Script Name:  install-haos
# Version:      0.4.0-dev
# Description:  Add system shutdown and re-order some functions
# ==============================================================================

# ==============================================================================
# - GLOBAL VARIABLES & CONFIGURATION
# ==============================================================================

TARGET_DISK=""
DOWNLOAD_URL=""
RELEASE_NAME=""
SCRIPT_VERSION=""


# ==============================================================================
# - COLORS, VISUAL THEME & BANNER LAYOUTS
# ==============================================================================

# Color definitions using the 256-color palette
load_colors() {
  blu=$'\e[38;5;39m'
  orn=$'\e[38;5;208m'
  red=$'\e[1;31m'
  end=$'\e[0m'
}

show_banner() {
  clear
  echo "${blu}"
  echo '   _  _  ___  __  __ ___      _   ___ ___ ___ ___ _____ _   _  _ _____  '
  echo '  | || |/ _ \|  \/  | __|    /_\ / __/ __|_ _/ __|_   _/_\ | \| |_   _| '
  echo '  | __ | (_) | |\/| | _|    / _ \\__ \__ \| |\__ \ | |/ _ \| .` | | |   '
  echo '  |_||_|\___/|_|  |_|___|  /_/ \_\___/___/___|___/ |_/_/ \_\_|\_| |_|   '
  echo '~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'
  echo '                  HOME ASSISTANT OS INSTALLATION ISO                    '
  echo '~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'
  echo -e "${end}"
}


# ==============================================================================
# - USER DEFINED FUNCTIONS
# ==============================================================================

get_release() {
  local api_url="https://api.github.com/repos/home-assistant/operating-system/releases/latest"
  local response

  echo -e "\n${orn}Fetching latest release data from GitHub...\n${end}"
  response=$(curl -sL "${api_url}")

  if [ -z "${response}" ] || ! echo "${response}" | jq -e . >/dev/null 2>&1; then
    echo -e "\n${red}Error: Invalid JSON${end}\n"
    return 1
  fi

  RELEASE_NAME="haos_ova-$(echo "${response}" | jq -r '.tag_name')"
  DOWNLOAD_URL=$(echo "${response}" | jq -r '.assets[] | select(.name | test("ova.*qcow2\\.xz$")) | .browser_download_url')

  if [ -z "${DOWNLOAD_URL}" ] || [ "${DOWNLOAD_URL}" = "null" ]; then
    echo -e "\n${red}Error: Download URL not found${end}\n"
    return 1
  fi

  echo "Release Data Found:"
  echo "  Version:  ${RELEASE_NAME}"
  echo "  Source:   ${DOWNLOAD_URL}"

  echo -e "\n${blu}Downloading and decompressing image archive...${end}"
  curl -sL "${DOWNLOAD_URL}" | unxz > "${RELEASE_NAME}.qcow2"
}


probe_disk() {
  local disks=($(lsblk -d -n -o NAME | grep -v '^loop' | grep -v 'rom' | grep -v '^sr'))
  local disk_count=${#disks[@]}

  echo -e "\n${orn}Probing system for available storage devices...\n${end}"

  if [ "${disk_count}" -eq 0 ]; then
    echo -e "\n${red}Error: No disks detected${end}\n"
    return 1
  else
    echo -e "\nStorage device probe complete"
  fi

  # Selects the first target disk (auto-assign if single, show error and exit if multiple)
  if [ "${disk_count}" -eq 1 ]; then
    TARGET_DISK="/dev/${disks[0]}"
    echo -e "Disk Detected: ${blu}${TARGET_DISK}${end}\n"
  else
    # NOTE: Could add code here for selecting correct disk from a menu
    echo -e "\n${red}Error: Multiple disks detected${end}"
    echo ${disks[@]}
    return 1
  fi
}


install_haos() {
  if [ -z "${TARGET_DISK}" ] || [ ! -f "${RELEASE_NAME}.qcow2" ]; then
    echo -e "${red}Error: Target disk not set or image file missing${end}"
    return 1
  fi

  echo "Writing image to ${TARGET_DISK}..."
  qemu-img convert -p -O raw "${RELEASE_NAME}.qcow2" "${TARGET_DISK}"
  local convert_status=$?

  if [ ${convert_status} -eq 0 ]; then
    sync
    echo -e "\n${blu}SUCCESS: Home Assistant OS has been successfully installed to ${TARGET_DISK}!${end}\n"
    echo "You can now safely shut down the live ISO environment and reboot into HAOS!"
    echo "Note you may need to remove the CD-ROM or change it's boot order so HAOS will boot"
  else
    echo -e "\n${red}CRITICAL ERROR: Image translation or write operations failed.${end}"
    return 1
  fi
}


get_script_version() {
  # Extract the version from the line starting with '# Version:'
  SCRIPT_VERSION=$(grep -m1 '^# Version:' "$0" | awk '{print $NF}')
  echo -e "\nSCRIPT VERSION: ${SCRIPT_VERSION}"
}


pause() {
  echo
  read -rp "Press ENTER to continue..." fakEnterKey
}


goodbye() {
  echo -e "${end}"
  clear
  exit
}


shutdown_system() {
  echo -e "${red}Powering off...${end}"
  clear
  poweroff
}


# ==============================================================================
# - TRAP CTRL+C, CTRL+Z AND QUIT SINGLES
# ==============================================================================

# Define standard signal traps to drop back to the console safely if interrupted
#  Trap on --- use 'kill -l' to list all
#   1 = SIGHUP (Hangup of controlling terminal or death of parent)
#   2 = SIGINT (Interrupted by the keyboard)
#   3 = SIGQUIT (Quit signal from keyboard)
#   6 = SIGABRT (Aborted by abort(3))
#

# It's a trap! goodbye
trap goodbye 1 2 3 6


# ==============================================================================
# - MAIN LOGIC AND INTERFACE LOOP
# ==============================================================================

load_colors

while true; do
  show_banner
  echo " 1) Install HAOS"
  echo " 2) Shutdown System"
  echo " 3) Exit to Console"
  echo ""
  
  read -rp "Select: " user_input
  echo ""

  case "${user_input}" in
    "1")
      echo "Starting Home Assistant OS installation..."
      probe_disk || { pause; continue; }
      # Final warning before initiating the destructive write pipeline
      echo -e "${red}WARNING: This will completely erase all data on ${orn} ${TARGET_DISK}!${end}"
      read -rp "Are you sure you want to proceed? (y/N): " confirm
      if [[ ! "${confirm}" =~ ^[yY]$ ]]; then
        echo -e "\nDeployment cancelled by user."
        pause
        continue
      fi
      get_release || { pause; continue; }
      install_haos || { pause; continue; }
      pause
      ;;
    "2"|[sS]|[sS][hH][uU][tT][dD][oO][wW][nN])
      shutdown_system
      ;;
    "3"|[eE]|[eE][xX][iI][tT]|[qQ])
      goodbye
      ;;
    *)
      # Checks if the user_input matches a defined function inside this file
      if [ -n "${user_input}" ] && [ "$(type -t -- "${user_input}")" = "function" ]; then
        clear
        # Execute the function if it exists
        "${user_input}"
        pause
      else
        echo "Sorry, that is not an option."
        sleep 1
      fi
      ;;
  esac
done
