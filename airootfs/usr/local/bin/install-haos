#!/usr/bin/env bash

# A menu-driven shell script, hacked together from my limited knowledge and AI slop
# In a previous life, this was the console menu for the Home Assistant TrueNAS Core
#  Community Plugin - Now, it's reborn to install Home Assistant OS in a TrueNAS VM

# ==============================================================================
# - SCRIPT METADATA AND VERSION CONTROL
# ==============================================================================
# Script Name:  install-haos
# Version:      26.11.3
# Description:  Install Home Assistant OS in a Virtual Machine
# ==============================================================================

# ==============================================================================
# - GLOBAL VARIABLES
# ==============================================================================

  SCRIPT_VERSION=""
  TARGET_DISK=""
  HAOS_VERSION=""
  IMAGE_NAME=""
  DOWNLOAD_URL=""

# ==============================================================================
# - COLORS AND BANNER LAYOUT
# ==============================================================================

# Color definitions using the 256-color palette
load_colors() {
  blu=$'\e[38;5;39m'
  orn=$'\e[38;5;208m'
  red=$'\e[1;31m'
  end=$'\e[0m'
}

# shellcheck disable=SC2028
show_banner() {
  clear
  echo -e "${blu}"
  echo '   _  _  ___  __  __ ___      _   ___ ___ ___ ___ _____ _   _  _ _____  '
  echo '  | || |/ _ \|  \/  | __|    /_\ / __/ __|_ _/ __|_   _/_\ | \| |_   _| '
  echo '  | __ | (_) | |\/| | _|    / _ \\__ \__ \| |\__ \ | |/ _ \| .` | | |   '
  echo '  |_||_|\___/|_|  |_|___|  /_/ \_\___/___/___|___/ |_/_/ \_\_|\_| |_|   '
  echo '~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'
  echo '                  HOME ASSISTANT OS INSTALLATION ISO                    '
  echo '~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~'
  echo -e "${end}"
}

# ==============================================================================
# - MAIN FUNCTIONS
# ==============================================================================

probe_disk() {
  echo "Probing system for available storage devices..."
  # shellcheck disable=SC2207
  local disks=($(lsblk -d -n -o NAME | grep -v '^loop' | grep -v 'rom' | grep -v '^sr'))
  local disk_count=${#disks[@]}
  if [ "${disk_count}" -eq 0 ]; then
    echo -e "\n${red}ERROR:${end} No disks detected\n"
    return 1
  elif [ "${disk_count}" -eq 1 ]; then
    TARGET_DISK="/dev/${disks[0]}"
  else
    # NOTE: Could add code here for selecting correct disk from a menu
    echo -e "\n${red}ERROR:${end} Multiple disks detected"
    echo "${disks[@]}"
    return 1
  fi
}


get_haos_info() {
  local api_url="https://api.github.com/repos/home-assistant/operating-system/releases"
  local response ova_asset
  echo "Fetching latest release info from GitHub..."
  response=$(curl -sL "${api_url}")
  if [ -z "${response}" ] || ! echo "${response}" | jq -e . >/dev/null 2>&1; then
    echo -e "\n${red}ERROR:${end} Invalid JSON\n"
    return 1
  fi
  ova_asset=$(echo "${response}" | jq -c '[ .[] | select(.prerelease == false) | .assets[] | select(.name | test("ova.*qcow2\\.xz")) ] | first')
  HAOS_VERSION=$(echo "${response}" | jq -r '[ .[] | select(.prerelease == false) | select(.assets[].name | test("ova.*qcow2\\.xz")) ] | first | .tag_name')
  IMAGE_NAME=$(echo "${ova_asset}" | jq -r '.name' | sed 's/\.xz$//')
  DOWNLOAD_URL=$(echo "${ova_asset}" | jq -r '.browser_download_url')
  if [ -z "${DOWNLOAD_URL}" ] || [ "${DOWNLOAD_URL}" = "null" ]; then
    echo -e "\n${red}ERROR:${end} Download URL not found\n"
    return 1
  fi
}


download_haos() {
  if [ -z "${DOWNLOAD_URL}" ] || [ -z "${IMAGE_NAME}" ]; then
    echo -e "\n${red}ERROR:${end} Missing release download metadata\n"
    return 1
  fi
  echo "Downloading and decompressing HAOS image..."
  set -o pipefail
  curl -Lf --progress-bar "${DOWNLOAD_URL}" | unxz > "${IMAGE_NAME}"
  local exit_code=$?
  set +o pipefail
  # Check if the download failed or was interrupted
  if [ ${exit_code} -ne 0 ] || [ ! -s "${IMAGE_NAME}" ]; then
    echo -e "\n${red}ERROR:${end} Download or decompression failed\n"
    rm -f "${IMAGE_NAME}"
    return 1
  fi
}


install_haos() {
  if [ -z "${TARGET_DISK}" ] || [ ! -f "${IMAGE_NAME}" ]; then
    echo -e "\n${red}ERROR:${end} Target disk not set or image file missing\n"
    return 1
  fi
  echo "Writing image to ${TARGET_DISK}..."
  qemu-img convert -p -O raw "${IMAGE_NAME}" "${TARGET_DISK}"
  local convert_status=$?
  if [ ${convert_status} -eq 0 ]; then
    sync
    echo -e "\n${blu}SUCCESS:${end} Home Assistant OS has been successfully installed to ${TARGET_DISK}!\n"
    echo "You can now safely shut down the live ISO environment and reboot into HAOS!"
    echo "Note you may need to remove the CD-ROM or change its boot order so HAOS will boot"
  else
    echo -e "\n${red}ERROR:${end} Image conversion or write operation failed\n"
    return 1
  fi
}

# ==============================================================================
# - UTILITY OR HELPER FUNCTIONS
# ==============================================================================

get_script_version() {
  # Extract the script version from the line starting with '# Version:'
  SCRIPT_VERSION=$(grep -m1 '^# Version:' "$0" | awk '{print $NF}')
}

show_info() {
  echo -e "${blu}SCRIPT VERSION:${end} ${SCRIPT_VERSION}"
  echo -e "${blu}TARGET DISK:${end} ${TARGET_DISK}"
  echo -e "${blu}HAOS VERSION:${end} ${HAOS_VERSION}"
  echo -e "${blu}IMAGE NAME:${end} ${IMAGE_NAME}"
  echo -e "${blu}DOWNLOAD URL:${end} ${DOWNLOAD_URL}"
}

# shellcheck disable=SC2034
pause() {
  echo ""
  read -rp "Press ENTER to continue..." fakEnterKey
}

goodbye() {
  echo -e "${end}" ; clear ; exit
}

# ==============================================================================
# - TRAP CTRL+C, CTRL+Z AND QUIT SIGNALS
# ==============================================================================

# Define standard signal traps to drop back to the console safely if interrupted
#  Trap on --- use 'kill -l' to list all
#   1 = SIGHUP (Hangup of controlling terminal or death of parent)
#   2 = SIGINT (Interrupted by the keyboard)
#   3 = SIGQUIT (Quit signal from keyboard)
#   6 = SIGABRT (Aborted by abort(3))

# It's a trap! goodbye
trap goodbye 1 2 3 6

# ==============================================================================
# - MAIN LOGIC AND INTERFACE LOOP
# ==============================================================================

load_colors

while true; do
  show_banner
  echo " 1) Install HAOS"
  echo " 2) Show Verification"
  echo " 3) Reboot System"
  echo " 4) Shutdown System"
  echo " 5) Exit to Console"
  echo ""
  
  read -rp "Select: " user_input
  echo ""

  case "${user_input}" in
    "1")
      echo "Starting Home Assistant OS installation..."
      get_script_version
      probe_disk || { pause; continue; }
      get_haos_info || { pause; continue; }
      echo -e "\n---- Ready to Install ----"
      show_info
      # Final warning before initiating nuke and pave operation
      echo -e "\n${orn}WARNING:${end} All data on ${TARGET_DISK} will be overwritten!"
      read -rp "Are you sure you want to proceed? (y/N): " confirm
      if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        echo -e "${red}Installation cancelled${end}"
        pause; continue
      fi
      echo ""
      # Download and Install
      download_haos || { pause; continue; }
      install_haos || { pause; continue; }
      pause
      ;;
    "2"|[vV]|[vV][eE][rR][iI][fF][yY])
      get_script_version
      probe_disk || { pause; continue; }
      get_haos_info || { pause; continue; }
      echo ""
      show_info
      pause
      ;;
    "3"|[rR]|[rR][eE][bB][oO][oO][tT])
      echo -e "\n${red}Rebooting...${end}" ; reboot
      ;;
    "4"|[sS]|[sS][hH][uU][tT][dD][oO][wW][nN])
      echo -e "\n${red}Powering off...${end}" ; poweroff
      ;;
    "5"|[eE]|[eE][xX][iI][tT]|[qQ])
      goodbye
      ;;
    *)
      # Checks if the user_input matches a defined function inside this file
      if [ -n "${user_input}" ] && [ "$(type -t -- "${user_input}")" = "function" ]; then
        clear
        # Execute the function if it exists
        "${user_input}"
        pause
      else
        echo "Sorry, that is not an option." ; sleep 1
      fi
      ;;
  esac
done
